PORT=5000
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster_address>/jornal_manifesto?retryWrites=true&w=majority
JWT_SECRET=sua_chave_secreta_aqui_super_segura
NODE_ENV=development

# Configurações de Produção - E-mail (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=seu_email@gmail.com
EMAIL_PASS=sua_senha_de_aplicativo_do_gmail
EMAIL_FROM=no-reply@manifesto.com

# Configurações de Produção - SMS (Twilio)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
